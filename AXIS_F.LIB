  end while
  axSeq = seqNum
  axRef = lAxisRef
  axNewHome = 1
  axRespFileDesc = lSocket
' start a new motion
  semaphoreGive(semMove)
end sub


' move group inner function
sub grMove(byval lSocket as long, byval seqNum as long, byval  lAxisRef as long, byval dXPos as double, byval dYPos as double,byval dZPos as double,byval dValVelocity as double, byval lAbs as long)
  
' aquire motion semaphore
  while semaphoreTake(semMove, 10) = 0 
    sleep 1
  end while
  axSeq = seqNum
  axRef = lAxisRef
  grTarget[1] = dxPos
  grTarget[2] = dYPos
  grTarget[3] = dZPos
  grVel = dValVelocity
  grAbs  = lAbs
  grNewTarget = 1
  axRespFileDesc = lSocket
' start a new motion
  semaphoreGive(semMove)
end sub

' move touch group inner function
sub touchMove(byval lSocket as long, byval seqNum as long, byval  lAxisRef as long, byval dXPrePos as double, byval dYPrePos as double,byval dZPrePos as double,byval dXPos as double, byval dYPos as double,byval dZPos as double,byval dPreVelocity as double,byval dVelocity as double, byval lAbs as long)
  
' aquire motion semaphore
  while semaphoreTake(semMove, 10) = 0 
    sleep 1
  end while
  axSeq = seqNum
  axRef = lAxisRef
  touchPreTarget[1] = dXPrePos
  touchPreTarget[2] = dYPrePos
  touchPreTarget[3] = dZPrePos
  
  touchTarget[1] = dXPos
  touchTarget[2] = dYPos
  touchTarget[3] = dZPos
  
  touchPreVel = dPreVelocity
  touchVel  = dVelocity
  touchEnable = 1
  axRespFileDesc = lSocket
' start a new touch
  semaphoreGive(semMove)
end sub

