public sub calcRate(gG as generic group, rate as double, byval dTargetX as double, byval dTargetY as double)
    dim dx as double
    dim dy as double
    dim dDistance as double

    dx = gG.here{1} - dTargetX
    dy = gG.here{2} - dTargetY
    print "gG.here{1} is ", gG.here{1}, "gG.here{2} is ", gG.here{2}, "X is ",dTargetX, "Y is ",dTargetY

    dDistance = SQRT(dx*dx + dy*dy)
    print "dDistance is ", dDistance
    if dDistance <= 0.5 then
        rate = 6
    end if

    if 0.5 < dDistance and dDistance <= 0.75 then
        rate =10
    end if

    if 0.75 < dDistance and dDistance <= 0.95 then
        rate =15
    end if

    if 0.95 < dDistance and dDistance <= 4.5 then
        rate = 20
    end if

    if 4.5 < dDistance and dDistance <= 5.5 then
        rate = 40
    end if

    if 5.5 < dDistance and dDistance <= 6.5 then
        rate = 70
    end if

    if 6.5 < dDistance and dDistance <= 7.5 then
        rate = 85
    end if

    if dDistance > 7.5 then
        rate = 90
    end if

end sub


public sub GetLatch(byval lSocket as long, byval seqNum as long, byval ax as long, byval count as long)

    dim str_latch as string
    dim axisPrefix as string
    dim values as double
    dim lnums as long
    dim i as long

    ' Determine axis prefix
    select case ax
        case 1
            axisPrefix = "X"
            lnums = xLatch[1]+1
        case 2
            axisPrefix = "Y"
            lnums = yLatch[1]+1           
        case 3
            axisPrefix = "Z"
            lnums = zLatch[1]+1          
        case else
            axisPrefix = "?"  ' Unknown axis
            lnums = 0
    end select

    str_latch = "LATCH_" + axisPrefix + ":"

    ' Build payload depending on index
    if count = -1 and lnums > 1 then
        ' Send all values from 1 to count
        for i = 2 to lnums
            select case ax
                case 1
                    values = xLatch[i]
                case 2
                    values = yLatch[i]
                case 3
                    values = zLatch[i]
                case else
                    values = 0
            end select
            str_latch = str_latch + STR$(i) + "=" + STR$(values) + ";"
        next
    end if

    if count > 0 and count <= lnums then
      select case ax
          case 1
              values = xLatch[count]
          case 2
              values = yLatch[count]
          case 3
              values = zLatch[count]
          case else
              values = 0
      end select
      str_latch = STR$(count) + "=" + STR$(values) + ";"
    end if
    call sendResponceString(lSocket,seqNum,str_latch)
    latch_str = str_latch
    ' print #lSocket, str_latch

end sub


public sub latchArrayClear(byval lSocket as long, byval seqNum as long, byval ax as long)
  dim i as long 
  select case ax
    case 1
      for i = 1 to 500
        xLatch[i] = 0
      next
    case 2
      for i = 1 to 500
        yLatch[i] = 0
      next
    case 3
      for i = 1 to 500
        zLatch[i] = 0
      next
  end select
end sub






