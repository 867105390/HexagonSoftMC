'*****************************************************************************
' added by chi to support set op mode and other functions

''clear all system states
public sub resetSys(byval lSocket as long, byval seqNum as long)
   dim lError as long = 0 
   dim tryTimes as long = 0
   dim xdone as long =0
   ' Cancel through MHGR cleanup before resetting tasks or clearing faults.
   duoHomeCancel = 1
   call DuoEnableGroup(0)
   while grNewHome and TaskState("MHGR.PRG") = 1
     sleep 10
   end while
   if grNewHome then
     grNewHome = 0
     homingIsDone = 0
   end if
   duoHomeCancel = 0
   if sys_simulated = 0 then
   for trytimes = 1 to 5
     call ec_clear_faults(1)
     call ec_clear_faults(2)
     call ec_clear_faults(3)
     call ec_clear_faults(4)
     call ec_clear_faults(5)
   next trytimes
   end if
   tryTimes = 0
   
   call DuoEnableGroup(0)
   while gxyz.En <> 0
    sleep 10
   end while
   
  
  while TaskState("jog_x.prg") = 1
      KillTask$ "jog_x.prg"
     sleep 10
  end while
  

  
  while TaskState("jog_y.prg") = 1
      KillTask$ "jog_y.prg"
     sleep 10
  end while
  

  
    while TaskState("jog_z.prg") = 1
      KillTask$ "jog_z.prg"
     sleep 10
  end while
    
  
  while TaskState("MVAXES.prg") = 1
      KillTask$ "MVAXES.prg"
     sleep 10
  end while
  


  while TaskState("MVGROUP.prg")= 1
      KillTask$ "MVGROUP.prg"
     sleep 10
  end while  

  
  while TaskState("MHGR.prg") = 1
      KillTask$ "MHGR.prg"
     sleep 10
  end while  
  ' Need restart Tman.prg ,If Tman has some error
  while not xdone  
      
      if TaskState("TMAN.prg")=1 then
        xdone=1
        else
        startTask$ "TMAN.prg"
        xdone=1
      end if
      sleep 10
  end while
    
  xdone=0
  
  SYS_OP_MODE = SYS_OP_IPP_MODE
  
  while (SYS_OP_MODE <> SYS_OP_IPP_MODE) AND (tryTimes < 10)
          SYS_OP_MODE = SYS_OP_IPP_MODE
          tryTimes = tryTimes+1
          sleep 1
  end while 
  
  SYS_OP_MODE_CHANGE = 1
  
  sleep 100
  
  if SYS_OP_MODE <> SYS_OP_IPP_MODE then
      lError = 7702         ''set sys mode error
      call sendResponce(lSocket,seqNum,lError)
  end if
  
  

  
 '' sleep 500  
 call sendResponce(lSocket,seqNum,lError)
    
end sub



''clear TRIGGER_SIG value, indicates that trigger data has been fetched by ipp
public sub trigClear(byval lSocket as long, byval seqNum as long)
  
  dim tryTimes as long = 0
  dim lError as long = 0 
  TRIGGER_SIG = 0
  
  while (TRIGGER_SIG <> 0) AND (tryTimes < 10)
      TRIGGER_SIG = 0
      tryTimes = tryTimes+1
      sleep 1
  end while 
  
  TRIGGER_SIG_CLEAR_FLAG = 1
  
  
  if TRIGGER_SIG <> 0 then
      lError = 9701       'Clear Trigger signal faild
  end if
  
  call sendResponce(lSocket,seqNum,lError)
    
end sub



''enable jog operation
public sub enableJog(byval lSocket as long, byval seqNum as long)

  call setSysOpMode(lSocket,seqNum,1)

end sub

''enable mc jog operation
public sub enableMcJog
  call setMcOpMode(1)  
end sub

'enable softjog operation
public sub enableSoftJog(byval lSocket as long, byval seqNum as long)
  call setSysOpMode(lSocket,seqNum,1)
end sub




''disable jog operation
public sub disableJog(byval lSocket as long, byval seqNum as long)
  
  call setSysOpMode(lSocket, seqNum,2) 
 
end sub

''disable mc jog operation
public sub disableMcJog
  call setMcOpMode(2)
end sub



public sub getSysOpMode(byval lSocket as long, byval seqNum as long)

  call  sendResponceLong(lSocket,seqNum,0,SYS_OP_MODE)
end sub


'set system operation mode 
'return value : 
'         0:      suceed
'         7701:   failed to set op mode 

sub setSysOpMode(byval lSocket as long, byval seqNum as long,byval lVal as long)
  dim tryTimes as long = 0
  dim lError as long = 0 
  SYS_OP_MODE = lVal
  
'  EventOFF TPJOG
  
  
  while (SYS_OP_MODE <> lVal) AND (tryTimes < 10)
      SYS_OP_MODE = lVal
      tryTimes = tryTimes+1
      sleep 1
  end while 
  
  SYS_OP_MODE_CHANGE = 1
  
  
  if SYS_OP_MODE <> lVal then
      lError = 7701       'OP MODE set failed
  end if
   while  SYS_OP_MODE_CHANGE '之前因为第一个点会先发 disablejog,过4ms之后 马上就发第二条 那么第二条指令 ，因为原先切换模式还在执行中，就被忽略了。所以必须先等上一次动作完成，才能返回给上位机状态
    sleep 4
  end while 
  call sendResponce(lSocket,seqNum,lError)
  
end sub

sub setMcOpMode(byval lVal as long)
  dim tryTimes as long = 0
  dim lError as long = 0 
  SYS_OP_MODE = lVal
  
  EventOFF TPJOG
  
  while (SYS_OP_MODE <> lVal) AND (tryTimes < 10)
      SYS_OP_MODE = lVal
      tryTimes = tryTimes+1
      sleep 1
  end while 
  
  SYS_OP_MODE_CHANGE = 1
  
  
  if SYS_OP_MODE <> lVal then
      lError = 7701       'OP MODE set failed
  end if
  
'  call sendResponce(lSocket,seqNum,lError)
  
end sub


