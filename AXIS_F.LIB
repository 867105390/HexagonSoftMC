end sub

' set Pcom Table Position
public sub setPcomTablePos(byval lSocket as long,byval seqNum as long, byval ax as long, byval posList as string)
  dim i as long = 0

  for i = 1 to pcomMaxPoints 
    pcomPosition[ax][i] = 0
  next
  call data_extract(pcomPosition, posList, ax)
  call setPCom2Drive(ax, pcomPosition)

end sub

' set Pcom Periodic information
public sub setPcomPositionPeriodic(byval lSocket as long,byval seqNum as long,byval ax as long, byval startPos as double, byval endPos as double, byval Periodic as double)
  dim dMVar as double
  dim posFactor as long

  select case ax
    case 1
      posFactor = X.PFAC
    case 2
      posFactor = Y.PFAC
    case 3
      posFactor = Z.PFAC
  end select

  if startPos > endPos then
    endPos = RealEndCal(startPos, endPos, Periodic)
    dMVar = startPos
    startPos = endPos
    endPos = dMVar
  end if
  
  try
    call EC_SDO_WRITE(ax, 0x2191, 0, 16 , 0)
    call EC_SDO_WRITE(ax, 0x219B, 0, 32 , startPos*posFactor)
    call EC_SDO_WRITE(ax, 0x219D, 0, 32 , endPos*posFactor) 
    call EC_SDO_WRITE(ax, 0x219F, 0, 32 , Periodic*posFactor)
    catch else
  end try

end sub

'The switch of PCOM
' tp = 1 Periodic
' tp = 2 Table
' Switch = 0(Close), Switch = 1(Open)
public sub pcomSwitch(byval lSocket as long,byval seqNum as long,byval ax as long, byval tp as long, byval switch as long, byval direc as long)
  if tp = 1 and switch = 1 then
    try
      call EC_SDO_WRITE(ax, 0x2191, 0, 16 , 25)
      call pcomDirectionSet(ax, direc)
    catch else
      ' print "Open PCOM25 failed!" 
    end try   
  end if
 
  if tp = 1 and switch = 0 then
    try
      call EC_SDO_WRITE(ax, 0x2191, 0, 16 , 0)
    catch else
      ' print "Close PCOM25 failed!" 
    end try   
  end if
  
  if tp = 2 and switch = 1 then
    try
      call EC_SDO_WRITE(ax, 0x2191, 0, 16 , 19)
      call pcomDirectionSet(ax, direc)
    catch else
      ' print "Open PCOM19 failed!" 
    end try   
  end if
  
  if tp = 2 and switch = 0 then
    try
      call EC_SDO_WRITE(ax, 0x2191, 0, 16 , 0)
    catch else
      ' print "Close PCOM19 failed!" 
    end try   
  end if

  if switch = 1 then
    latchFlag = 1
  else
    latchFlag = 0
    preLatchPos = LatchGetPosition(3)
  end if
  
end sub


sub pcomDirectionSet(byval ax as long, byval direc as long)
  select case direc
    case 0
      call EC_SDO_WRITE(ax, 0x2195, 0, 16 , 0)
    case 1
      call EC_SDO_WRITE(ax, 0x2195, 0, 16 , 1)    
    case 2
      call EC_SDO_WRITE(ax, 0x2195, 0, 16 , 2)
  end select
end sub

sub setPCom2Drive(byval ax as long, posArray[*][*] as double)
  dim lNums as long
  dim lIndex as long
  dim lPos as long
  dim posFactor as long
  dim lPComTableLength_0x2197 as long = 0x2197

  lNums = posArray[ax][1]

  select case ax
    case 1
      posFactor = X.PFAC
    case 2
      posFactor = Y.PFAC
    case 3
      posFactor = Z.PFAC
  end select

  try
    call EC_SDO_WRITE(ax, 0x2191, 0, 16 , 0)
    for lIndex = 1 to lNums
      lPos = posArray[ax][lIndex+1] * posFactor
      call SetPComTable(ax, lIndex, lPos)
    next
  catch else 
  end try
  
  ' Write the number of PCOMTable into pcomtableLen1
  call EC_SDO_WRITE(ax, lPComTableLength_0x2197, 0, 16 , lNums)

end sub


sub SetPComTable(byval ax as long, byval seq as long, byval pos as long)
  dim lPComTable_0x21A1 as long = 0x21A1

  call EC_SDO_WRITE(ax, lPComTable_0x21A1, 1, 32 , seq)
  call EC_SDO_WRITE(ax, lPComTable_0x21A1, 2, 32 , pos)
  call EC_SDO_WRITE(ax, lPComTable_0x21A1, 3, 32 , 1)
end sub 

sub data_extract(posArray[*][*] as double, byval arrayContent as string, byval ax as long)
  dim lLocBracketsOpen  as Long
  dim lLocBracketsClose as Long
  dim lStringLength     as Long
  dim sNums             as string
  dim lCommaPos         as long
  dim data_nums         as long


  lLocBracketsOpen = Instr(arrayContent, "[") 
  lStringLength    = Len(arrayContent)
  arrayContent   = Right$(arrayContent, lStringLength - lLocBracketsOpen+1)
  lLocBracketsClose= Instr(arrayContent, "]") 
  sNums = Mid$(arrayContent, 2, lLocBracketsClose - 2)

  data_nums = 0
 
  While Instr(sNums, ",") > 0
    lCommaPos = Instr(sNums, ",")                          
    data_nums = data_nums + 1
    posArray[ax][data_nums+1] = Val(Left$(sNums, lCommaPos - 1))
    sNums = Right$(sNums, Len(sNums) - lCommaPos)
  end while

  if Len(sNums) > 0 Then
      data_nums = data_nums + 1
      posArray[ax][data_nums+1] = Val(sNums)
  end if 
  posArray[ax][1] = data_nums
  
end sub


public sub latchInit(byval lSocket as long,byval seqNum as long, byval ax as long)
  dim lObj60B8Value      as long
  dim lTouchProbeSetup_0x60B8  as long = 0x60B8
  call EC_SDO_WRITE(ax, lTouchProbeSetup_0x60B8, 0, 16, 1)  '  reset 
  Sleep 20
  lObj60B8Value = 0b00010011  'Binary Value for configuring First Touch Probe
  '1 bit: Enable touch probe 1
  '2 bit: continuous record
  '4 bit: samping at postive edge of touch probe 1
  call EC_SDO_WRITE(ax, lTouchProbeSetup_0x60B8, 0, 16,lObj60B8Value)
end sub


