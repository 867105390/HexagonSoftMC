public sub softJogMove(byval lSocket as long ,byval seqNum as long, byval  lAxisRef as long, byval lDirection as long, byval dValVelocity as double)
  if JOG_SWITCH_SPEED_SIGNAL <> 1 or JOG_SPEED_SWITCH_PRESSED <> 1 or JOG_SPEED <> JOG_FAST_SPEED then
      JOG_SWITCH_SPEED_SIGNAL = 1
      JOG_SPEED_SWITCH_PRESSED = 1
      JOG_SPEED = JOG_FAST_SPEED
      JOG_SPEED_CHANGE_FLAG = 1    
  end if  
  
  select case lAxisRef
    case 1
      JOG_MOVE_X_SIGNAL_SOFTWARE = -lDirection*dValVelocity*0.08
    case 2
      JOG_MOVE_Y_SIGNAL_SOFTWARE = -lDirection*dValVelocity*0.08
    case 3
      JOG_MOVE_Z_SIGNAL_SOFTWARE = -lDirection*dValVelocity*0.08
  end select
    
end sub

public sub softJogStop(byval lSocket as long ,byval seqNum as long)
  JOG_MOVE_X_SIGNAL_SOFTWARE = 0
  JOG_MOVE_Y_SIGNAL_SOFTWARE = 0
  JOG_MOVE_Z_SIGNAL_SOFTWARE = 0
  if JOG_SPEED_CHANGE_FLAG then
    JOG_SPEED_CHANGE_FLAG = 0
    JOG_SWITCH_SPEED_SIGNAL = 0
    JOG_SPEED_SWITCH_PRESSED = 0
    JOG_SPEED = JOG_SLOW_SPEED  
  end if
end sub  

public sub softGrStop(byval lSocket as long ,byval seqNum as long)
  grStop = 1
end sub

public sub grMoveCircle(byval lSocket as long ,byval seqNum as long, byval  lAxisRef as long, byval dXMidPos as double, byval dYMidPos as double, byval dZMidPos as double,byval dXEndPos as double, byval dYEndPos as double, byval dZEndPos as double, byval dValVelocity as double)
  call moveCircle(lSocket,seqNum ,lAxisRef,dXMidPos,dYMidPos,dZMidPos,dXEndPos,dYEndPos,dZEndPos,dValVelocity)
end sub

public sub softJogMoveMutil(byval lSocket as long ,byval seqNum as long, byval  lAxisRef as long, byval lxDirection as long, byval lyDirection as long, byval dxValVelocity as double, byval dyValVelocity as double)
  if JOG_SWITCH_SPEED_SIGNAL <> 1 or JOG_SPEED_SWITCH_PRESSED <> 1 or JOG_SPEED <> JOG_FAST_SPEED then
      JOG_SWITCH_SPEED_SIGNAL = 1
      JOG_SPEED_SWITCH_PRESSED = 1
      JOG_SPEED = JOG_FAST_SPEED
      JOG_SPEED_CHANGE_FLAG = 1    
  end if  
  JOG_MOVE_X_SIGNAL_SOFTWARE = -lxDirection*dxValVelocity*0.04
  JOG_MOVE_Y_SIGNAL_SOFTWARE = -lyDirection*dyValVelocity*0.04
end sub


' Enable axis
public sub axEnable(byval lSocket as long,byval seqNum as long,byval  lAxisRef as long,byval  lEna as long)
  dim lError as long
  try 
    call DuoEnableAxis(lAxisRef, lEna)
  catch else
      lError = user USR_GET_RECENT_ERROR(1,2,3)
  end try
      call sendResponce(lSocket,seqNum,lError)
end sub

' Enable Groupt
' Legacy host spelling: use the same five-axis implementation and response.
public sub grEn(byval lSocket as long,byval seqNum as long,byval lAxisRef as long,byval lEna as long)
  call grEnable(lSocket,seqNum,lAxisRef,lEna)
end sub

public sub grEnable(byval lSocket as long,byval seqNum as long,byval  lAxisRef as long,byval  lEna as long)
  dim lError as long
  try 
    call DuoEnableGroup(lEna)
  catch else
      lError = user USR_GET_RECENT_ERROR(1,2,3)
  end try
      call sendResponce(lSocket,seqNum,lError)
end sub

' Resume
public sub ProceedResume(byval lSocket as long,byval seqNum as long,byval  lAxisRef as long)
  dim lError as long
  dim gAx as generic axis
  dim gGr as generic group
  try 
    if lAxisRef > sys.AccelerationRate then
      gGr = systemgroup(lAxisRef)
      proceed gGr proceedtype = CONTINUE
    else
      gAx = systemaxis(lAxisRef)
      proceed gAx proceedtype = CONTINUE
    end if  
  catch else
      lError = user USR_GET_RECENT_ERROR(1,2,3)
  end try
     call sendResponce(lSocket,seqNum,lError)
end sub

' Clean Motion
public sub ProceedClean(byval lSocket as long,byval seqNum as long,byval  lAxisRef as long)
  dim lError as long
  dim gAx as generic axis
  dim gGr as generic group
  try 
    if lAxisRef > sys.AccelerationRate then
      gGr = systemgroup(lAxisRef)
      proceed gGr proceedtype = CLEARMOTION
    else
      gAx = systemaxis(lAxisRef)
      proceed gAx proceedtype = CLEARMOTION
    end if  
  catch else
      lError = user USR_GET_RECENT_ERROR(1,2,3)
  end try
      call sendResponce(lSocket,seqNum,lError)
end sub

' Stop axis/group
public sub eStop(byval lSocket as long,byval seqNum as long,byval  lAxisRef as long)
  dim lError as long
  dim gAx as generic axis
  dim gGr as generic group
  try 
    if lAxisRef > sys.AccelerationRate then
      gGr = systemgroup(lAxisRef)
      stop gGr stoptype=IMMEDIATE
    else
      gAx = systemaxis(lAxisRef)
      stop gAx stoptype=IMMEDIATE
    end if  
  catch else
      lError = user USR_GET_RECENT_ERROR(1,2,3)
  end try
     call sendResponce(lSocket,seqNum,lError)
end sub

  
